# mw2.env - settings for the classic Mac build. Rename to "mw2.env" and put it next to the application.
# One KEY=VALUE a line; '#' starts a comment. Mac OS 9 has no environment variables, so this file stands in for them.
# Everything here is optional - the game runs without the file.

# Video memory in MB, if the card misreports it (the resolution cap: 8 MB -> 800 x 600, 16 MB+ -> 1024 x 768)
#MW2_VRAM_MB=16

# Menu music: QuickTime's synthesizer even when the Gravis patches (ultrasnd folder) are there
#MW2_MUSIC=builtin

# Graphics: 16-bit textures (1, the default) or 32-bit (0); the HUD's Scale3x upscale (0, the default on the Mac)
#MW2_GL12_TEX16=1
#MW2_HUD_SCALE3X=0

# Let a card with one texture unit run anyway (a Rage Pro: fog in a second pass, slow)
#MW2_GL12_ALLOW_ONE_UNIT=1

# Diagnostics: the renderer's texture memory on the console at exit
#MW2_GL12_TRACE=1
